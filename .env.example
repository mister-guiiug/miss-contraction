# Sentry (suivi des erreurs). Absent : l'observabilité se tait, sans bruit.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# Identifiant de mesure GA4 (`G-…`), propre à CETTE application : une propriété
# par site, sinon les audiences se mélangent. Absent, le bandeau de consentement
# ne rend rien et rien n'est mesuré — c'est le seul interrupteur.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Build
VITE_BASE_PATH=/miss-contraction/
NODE_ENV=production
