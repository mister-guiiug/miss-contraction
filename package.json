{
  "name": "miss-contraction",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "tsc -b && vite build && pwa-bundle-budget",
    "build:analyze": "cross-env ANALYZE=1 npm run build",
    "build:netlify": "tsc -b && REACT_PREVIEW=1 vite build",
    "build:react-preview": "tsc -b && REACT_PREVIEW=1 vite build",
    "preview": "vite preview --base /miss-contraction/",
    "preview:react": "REACT_PREVIEW=1 vite preview --base /miss-contraction-react/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:critical": "playwright test --grep @critical",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:storage": "playwright test --grep @storage",
    "test:e2e:perf": "playwright test --grep @performance",
    "test:e2e:errors": "playwright test --grep @errors",
    "test:e2e:journey": "playwright test --grep @journey",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:e2e:load": "playwright test --grep @load",
    "test:e2e:mobile": "playwright test --grep @mobile --project=mobile-chrome --project=mobile-safari",
    "test:e2e:a11y": "playwright test --grep @a11y",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:snapshots:update": "vitest run --reporter=verbose --update",
    "test:all": "npm run test && npm run test:e2e",
    "icons": "pwa-icons --source public/icon.svg --out public/icons --sizes 192,512 --no-apple",
    "icons:maskable": "node scripts/generate-maskable.mjs",
    "type-check": "tsc -b",
    "type-check:7": "pwa-typecheck-7",
    "sync:vscode:tasks": "node scripts/sync-vscode-tasks.mjs",
    "check:vscode:tasks": "node scripts/sync-vscode-tasks.mjs --check"
  },
  "bundleBudget": {
    "totalGzipKb": 392,
    "_pourquoiPreload": "Posé le 16/09/2026, socle 4.18.0. Le total gzip compte TOUS les morceaux, asynchrones compris, et ne dit donc rien du chemin critique : il est identique que Sentry soit préchargé ou non. Cette borne compte ce que dist/index.html référence. Mesuré 170,2 kB, budget à +10 %.",
    "preloadGzipKb": 188,
    "_pourquoi": " — RELEVÉ DE 270 À 334 LE 16/09/2026 avec @sentry/react 8→10 : le SDK passe de 345 à 464 KiB bruts (151,1 kB gzip), dans un morceau ASYNCHRONE hors du précache. 303,4 kB mesurés, 334 = mesure + 10 %. Le chemin critique, lui, ne bouge pas : c est preloadGzipKb qui le garde. — RELEVÉ DE 334 À 392 LE 19/09/2026 : `posthog-js` entre avec l'ADR 0012, le parc quittant GA4 pour PostHog en Europe. 356,1 kB mesurés, 392 = mesure + 10 % (la formule du cliquet du socle). LE MORCEAU EST DIFFÉRÉ ET LE RESTE : il n'est chargé qu'APRÈS l'accord, et un visiteur qui refuse ne le télécharge jamais — c'est `preloadGzipKb`, inchangé par ce commit, qui garde le chemin critique. Le `loader` vise `posthog-js/dist/module.slim.js` : 48,9 kB gzip au lieu de 97,6 pour l'entrée par défaut, en laissant dehors l'enregistrement de session, l'autocapture, les sondages et la barre d'outils — que l'ADR 0012 coupe de toute façon. MESURER EN CI, PAS EN LOCAL."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@mister-guiiug/dev-pwa-config": "^6.13.0",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "web-vitals": "^6.2.2"
  },
  "dependencies": {
    "@sentry/react": "^10.75.3",
    "lucide-react": "^1.47.0",
    "posthog-js": "^1.434.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
